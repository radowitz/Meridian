{
  "name": "meridian-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "demo:build": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "demo:serve": "vite preview --config vite.demo.config.ts",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:fixtures": "cd .. && MERIDIAN_DEMO_FIXTURES=write go test ./internal/api -run 'TestDemoFixtures$' -count=1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@xyflow/react": "^12.3.6",
    "antd": "^5.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
