[Unit]
Description=Meridian host executor (fixed actions for the panel: activate, health, rollback, list update, acceptance drills; read-only unlock probe)
Documentation=file:///usr/share/doc/meridian/architecture.md
After=local-fs.target
# The panel container bind-mounts /run/meridian-host; create it first.
Before=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/meridian host-agent
Environment=MERIDIAN_HOST_SOCKET=/run/meridian-host/agent.sock
Environment=MERIDIAN_HOST_TOKEN_FILE=/etc/meridian-host/agent.token
Environment=MERIDIAN_HOST_LEDGER=/var/lib/meridian-host/ledger.json
Restart=on-failure
RestartSec=2
# The socket directory is root-only (0700) and must keep its inode across
# agent restarts, or the panel container's bind mount would go stale.
RuntimeDirectory=meridian-host
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=meridian-host
StateDirectoryMode=0700

# Least privilege. The agent only runs systemctl (PID 1 does the work over
# its root-only private socket), ip / nft (netlink, CAP_NET_ADMIN), sysctl on
# net.* (CAP_NET_ADMIN), journalctl (read) and docker restart of the fixed
# meridian-smartdns container, plus two fixed read-only docker calls on that
# container for the DNS query journal's capability gate (one "inspect" with
# a fixed format, one "exec ... /usr/sbin/smartdns -v"). It never runs a
# shell or a caller path; the up script itself runs inside meridian.service,
# not here.
# AF_INET / AF_INET6 are for the read-only unlock probe (/v1/probe): fixed
# catalog targets, sockets carrying an exit's fwmark (SO_MARK needs
# CAP_NET_ADMIN) from its transit address on lo, DNS through the exit's
# tunnel resolver. The probe never sends anything that fails the route check.
# The list update (/v1/lists) also uses AF_INET/AF_INET6: HTTPS downloads
# from the fixed sources in internal/lists (domestic jsDelivr mirror,
# overseas GitHub raw), then it writes only the list directories below and
# loads chnroute with one "nft -f" of a batch it generated itself. A LAN
# copy may replace the domestic source with
#   Environment=MERIDIAN_GEOSITE_BASE_URL=http://...   (drop-in only)
#   Environment=MERIDIAN_CHNROUTE_BASE_URL=http://...
# Acceptance drills (/v1/drill/*, the panel's 验收 page): three fixed
# drills whose only parameters are managed tunnel interface names and a
# bounded duration. An isolation loads one table of the agent's own,
# inet meridian_drill (nft, CAP_NET_ADMIN), whose blocked addresses the
# agent reads itself from "wg show <if> endpoints" and which carry a kernel
# timeout, so the block ends even if this service is killed. The record of a
# drill (state before, restore plan, deadline, phase) and the block's rules
# file live in the state directory (/var/lib/meridian-host/drill.json,
# drill.nft); an unfinished one is restored at start, before any other
# change is accepted. The read-only path check (/v1/acceptance/paths) runs
# only "ip -o link show" and two "wg show" subcommands that print no key.
User=root
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# Everything else stays read-only under ProtectSystem=strict.
# /var/lib/meridian-dnslog (root-only, the DNS query journal's data) is
# written by the agent in exactly one case: its parameterless "clear" while
# the journal's reader is not running, which deletes the audit file, its
# rotated copies and the journal segments from the two fixed directories
# (after the install that turned the journal off). It never reads their
# content and never writes anything there.
ReadWritePaths=-/var/lib/meridian/geosite -/var/lib/meridian/keywords -/var/lib/meridian/lists -/var/lib/meridian-dnslog
# A gateway withdraw removes the networkd drop-in meridian-up.sh writes
# (hostexec.NetworkdDropIn); install.sh creates the directory beforehand.
ReadWritePaths=-/etc/systemd/networkd.conf.d
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
